# Credentials for signing the Firefox build via Mozilla's web-ext.
#
# Copy to .env at the repo root (gitignored) and fill in. Create a key at
# https://addons.mozilla.org/en-US/developers/addon/api/key/
#
# AMO_JWT_ISSUER and AMO_JWT_SECRET are the two halves of one AMO API key.
# WEB_EXT_API_KEY / WEB_EXT_API_SECRET are equivalent names that web-ext also
# reads; set either pair, not both.
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
